# Database (use this in Docker; RDS later)
DATABASE_URL="postgresql://bloguser:<YOUR_DB_PASSWORD>@postgres:5432/blogdb"   # must match POSTGRES_PASSWORD in docker-compose.yml

# JWT
JWT_SECRET="change-me-in-production-use-long-random-string"

# Server
PORT=4000

# CORS — frontend origin (localhost in dev, your S3/CloudFront URL later)
CORS_ORIGIN="http://localhost:3000"

# Uploads stored locally (Stage 1); S3 later
UPLOAD_DIR="./uploads"
