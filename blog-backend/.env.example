# Database (use this in Docker; RDS later)
# Optional for local dev: docker-compose defaults POSTGRES_PASSWORD to the non-secret value "localdev_only".
# Override it here (untracked .env) if you want a custom local password; keep both lines in sync.
# POSTGRES_PASSWORD=localdev_only
DATABASE_URL="postgresql://bloguser:localdev_only@postgres:5432/blogdb"

# JWT
JWT_SECRET="change-me-in-production-use-long-random-string"

# Server
PORT=4000

# CORS — frontend origin (localhost in dev, your S3/CloudFront URL later)
CORS_ORIGIN="http://localhost:3000"

# Uploads stored locally (Stage 1); S3 later
UPLOAD_DIR="./uploads"
