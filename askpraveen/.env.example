# Local Postgres (docker-compose) — Session 1 only; not used from Session 2 onwards
DATABASE_URL=postgresql://askpraveen:askpraveen@localhost:5433/askpraveen

# Qdrant Cloud (Session 2+). Get these from https://cloud.qdrant.io/ after creating a cluster.
QDRANT_URL=https://<your-cluster-id>.<region>.aws.cloud.qdrant.io
QDRANT_API_KEY=<your-api-key>
QDRANT_COLLECTION=documents

# AWS
AWS_REGION=ap-south-1

# Bedrock model IDs (override to test alternates)
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
# Session 1 default: Nova Micro via APAC inference profile.
# Cheap ($0.035/$0.14 per Mtok), no Anthropic-use-case-form gate.
# Swap to anthropic.claude-3-haiku-20240307-v1:0 once the Anthropic form is approved.
BEDROCK_LLM_MODEL_ID=apac.amazon.nova-micro-v1:0

# Retrieval
TOP_K=5

# Content root (relative or absolute). Defaults to the parent blog repo.
CONTENT_ROOT=..
