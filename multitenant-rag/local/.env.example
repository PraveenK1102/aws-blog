# Local dev config for the ask app (copy to local/.env; local/.env is gitignored).
# AWS creds come from your ~/.aws profile — used for Bedrock (embeddings),
# Secrets Manager (Qdrant/Groq), and DynamoDB. Same cloud data as production.

AWS_REGION=ap-south-1
TENANTS_TABLE=multitenant-tenants
USERS_TABLE=multitenant-users
POSTS_TABLE=multitenant-posts
USAGE_TABLE=multitenant-usage-logs

# Groq model for local dev — 8b is fast + high free-tier limits (prod uses 70b).
GROQ_MODEL=llama-3.1-8b-instant

# Semantic answer cache (per-tenant, high threshold, invalidated on write)
QDRANT_CACHE_COLLECTION=multitenant_query_cache_dev
# SEMCACHE_ENABLED=true  SEMCACHE_THRESHOLD=0.95  SEMCACHE_TTL_SECONDS=86400

# --- Optional overrides (skip Secrets Manager; e.g. an alternate Groq account) ---
# GROQ_API_KEY=gsk_your_alternate_key
# QDRANT_URL=https://your-cluster.qdrant.io
# QDRANT_API_KEY=your_qdrant_key
